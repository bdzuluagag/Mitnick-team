        <mxCell id="p1-g1" value="&lt;b&gt;1. Decisión tardía&lt;/b&gt;&lt;br&gt;La alerta llega hasta 15 min después. Una transferencia inmediata sale en segundos y no se reversa." style="shape=note;size=14;align=left;spacingLeft=8;spacingRight=6;fontSize=11;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="1255" y="130" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p1-g2" value="&lt;b&gt;2. Sin contexto&lt;/b&gt;&lt;br&gt;Las reglas no ven el dispositivo, el comportamiento ni las redes de cuentas mula." style="shape=note;size=14;align=left;spacingLeft=8;spacingRight=6;fontSize=11;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="1255" y="290" width="200" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p1-g3" value="&lt;b&gt;3. Ruido&lt;/b&gt;&lt;br&gt;92 % de las alertas son falsos positivos y dos tercios quedan sin revisar." style="shape=note;size=14;align=left;spacingLeft=8;spacingRight=6;fontSize=11;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="1255" y="435" width="200" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p1-g4" value="&lt;b&gt;4. Sin aprendizaje&lt;/b&gt;&lt;br&gt;Los casos confirmados no vuelven a las reglas; se ajustan a mano." style="shape=note;size=14;align=left;spacingLeft=8;spacingRight=6;fontSize=11;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="1255" y="570" width="200" height="115" as="geometry" />
